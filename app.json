{
  "expo": {
    "name": "SIGNAL",
    "slug": "signal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "signalapp",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.marcus.signal",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "LSApplicationQueriesSchemes": [
          "youtube",
          "vnd.youtube",
          "yfinance",
          "yahoo",
          "upbit",
          "supertoss",
          "binance",
          "bnc"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#090A0F"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.marcus.signal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-updates",
      "expo-task-manager",
      "expo-background-task",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090A0F",
            "image": "./assets/images/splash-icon.png"
          },
          "ios": {
            "backgroundColor": "#F7F8FA",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#090A0F",
              "image": "./assets/images/splash-icon.png"
            }
          },
          "android": {
            "backgroundColor": "#F7F8FA",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#090A0F",
              "image": "./assets/images/splash-icon.png"
            }
          }
        }
      ],
      [
        "./plugins/expoNotificationsAndroidOnly.js",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3182F6"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "./plugins/withIosStatusBarAppearance.js",
      "./plugins/withIosEmbedJsOnDevice.js",
      "./plugins/withIosLaunchBackground.js",
      "./plugins/withIosAlternateAppIcons.js",
      "./plugins/removeIosPushEntitlement.js",
      "./plugins/removeIosAppleSignInEntitlement.js",
      "./plugins/withAndroidExternalAppQueries.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
