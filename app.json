{
  "expo": {
    "name": "SIGNAL",
    "slug": "signal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "signalapp",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.marcus.signal",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "LSApplicationQueriesSchemes": [
          "youtube",
          "vnd.youtube",
          "yfinance",
          "yahoo",
          "upbit",
          "supertoss",
          "binance",
          "bnc"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.marcus.signal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-updates",
      "expo-task-manager",
      "expo-background-task",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0A0F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "./plugins/expoNotificationsAndroidOnly.js",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00C087"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "./plugins/withIosStatusBarAppearance.js",
      "./plugins/withIosEmbedJsOnDevice.js",
      "./plugins/removeIosPushEntitlement.js",
      "./plugins/removeIosAppleSignInEntitlement.js",
      "./plugins/withAndroidExternalAppQueries.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
