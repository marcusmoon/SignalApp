{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal.app/schemas/disclosure-digest.v1.schema.json",
  "title": "Disclosure digest ingest v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["items"],
  "properties": {
    "notifyInbox": { "type": "boolean" },
    "sendPush": { "type": "boolean" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/digestItem" }
    }
  },
  "$defs": {
    "digestItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "market", "title", "summary", "generatedDate", "generatedAt", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "market": { "type": "string", "enum": ["us", "kr"] },
        "title": { "type": "string", "minLength": 1 },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "대표 공시 summary/title 기반 읽을거리. 건수·출처 메타만 금지."
        },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "companies": { "type": "array", "items": { "type": "string" } },
        "forms": { "type": "array", "items": { "type": "string" } },
        "count": { "type": "integer", "minimum": 0 },
        "importance": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "0 일반 · 1 정기/중간 · 2 중요 이벤트"
        },
        "score": { "type": "number" },
        "generatedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "generatedAt": { "type": "string", "minLength": 1 },
        "primaryDisclosureId": { "type": ["string", "null"] },
        "groupKey": { "type": "string" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": { "const": "disclosure" },
              "id": { "type": "string", "minLength": 1 },
              "relation": { "type": "string" }
            }
          }
        },
        "pushTitle": { "type": "string" },
        "pushBody": { "type": "string" },
        "notifyInbox": { "type": "boolean" }
      }
    }
  }
}
