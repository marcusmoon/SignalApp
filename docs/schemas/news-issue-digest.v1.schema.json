{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalapp.local/schemas/news-issue-digest.v1.schema.json",
  "title": "Signal News Issue Digest Ingest Payload",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "run", "items"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sendPush": {
      "type": "boolean",
      "default": true
    },
    "notifyInbox": {
      "type": "boolean",
      "default": true,
      "description": "When true, upsert notification_items for inbox. Independent of sendPush."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generatedAt", "window", "categories"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "generatedDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "locale": {
          "type": "string",
          "default": "ko"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            },
            "hoursBack": {
              "type": "integer",
              "minimum": 1,
              "maximum": 168
            }
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/category"
          },
          "uniqueItems": true
        },
        "policy": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "dedupe": {
              "type": "string"
            },
            "cluster": {
              "type": "string"
            },
            "ranking": {
              "type": "string"
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 36,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "string",
      "enum": ["global", "korea", "crypto"]
    },
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "category",
        "title",
        "summary",
        "generatedDate",
        "generatedAt",
        "groupKey",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "generatedDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "primaryNewsId": {
          "type": ["string", "null"]
        },
        "primaryPublishedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "groupKey": {
          "type": "string",
          "minLength": 1
        },
        "aiGenerated": {
          "type": "boolean",
          "default": true
        },
        "cluster": {
          "$ref": "#/$defs/cluster"
        },
        "impact": {
          "$ref": "#/$defs/impact"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "notifyInbox": {
          "type": "boolean",
          "description": "Per-item inbox opt-out when false; defaults to request notifyInbox"
        },
        "pushTitle": {
          "type": "string",
          "maxLength": 80
        },
        "pushBody": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["company", "sector", "macro", "crypto", "disclosure", "mixed"]
        },
        "eventType": {
          "type": "string",
          "enum": [
            "earnings",
            "guidance",
            "product",
            "regulation",
            "mna",
            "disclosure",
            "macro_data",
            "price_move",
            "analyst",
            "policy",
            "geopolitical",
            "market_flow",
            "other"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timeWindowHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "dedupeKey": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "type": "string",
          "enum": ["positive", "negative", "mixed", "neutral", "unknown"]
        },
        "horizon": {
          "type": "string",
          "enum": ["intraday", "short", "medium", "long", "unknown"]
        },
        "affectedAreas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "watchSymbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "title", "sourceName"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["news", "youtube", "filing", "calendar", "market"]
        },
        "id": {
          "type": ["string", "null"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": ["string", "null"]
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "relation": {
          "type": "string",
          "enum": ["primary", "supporting", "background"]
        }
      }
    }
  }
}
