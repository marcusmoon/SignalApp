{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIGNAL immutable news revisions",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "notifyInbox": { "type": "boolean" },
    "sendPush": { "type": "boolean" },
    "items": {
      "type": "array", "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["storyId", "category", "changeType", "title", "summary", "generatedAt", "changes", "sourceRefs"],
        "properties": {
          "storyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]{5,159}$" },
          "category": { "enum": ["global", "korea", "crypto"] },
          "changeType": { "enum": ["new", "update", "correction"] },
          "previousDigestId": { "type": ["string", "null"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "generatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
          "changes": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": {
              "type": "object", "required": ["text", "sourceIds"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 500 },
                "sourceIds": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "sourceRefs": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": {
              "type": "object", "required": ["type", "id", "relation"],
              "properties": {
                "type": { "const": "news" }, "id": { "type": "string", "minLength": 1 },
                "relation": { "enum": ["primary", "supporting"] }
              }
            }
          }
        }
      }
    }
  }
}
