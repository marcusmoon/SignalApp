{
  "name": "signal",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "preandroid": "node scripts/syncKakaoNativeConfig.mjs",
    "android": "expo run:android",
    "preios": "node scripts/ensureIosXcode27.mjs && node scripts/syncKakaoNativeConfig.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "SIGNAL_WEB_BASE_PATH=/web expo export --platform web --output-dir server/src/public/web",
    "server:build-with-web": "npm run web:export && npm --prefix server install",
    "railway:build": "CI=1 npm run web:export && npm --prefix server install",
    "railway:start": "npm --prefix server run start",
    "generate:splash": "node scripts/generateNativeSplash.mjs",
    "server:dev": "npm --prefix server run dev",
    "server:worker": "npm --prefix server run worker",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'domain/**/*.test.ts' 'utils/**/*.test.ts' 'services/**/*.test.ts'",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "expo": "^56.0.12",
    "expo-apple-authentication": "~56.0.4",
    "expo-auth-session": "~56.0.14",
    "expo-background-task": "~56.0.19",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.19",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-notifications": "~56.0.18",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.19",
    "expo-updates": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^16.3.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
