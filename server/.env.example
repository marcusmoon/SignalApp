# Local Signal API server
PORT=4000
HOST=127.0.0.1

# Browser / Expo Web: comma-separated allowed Origins (exact match). If unset, only
# http(s)://localhost:*, 127.0.0.1:*, [::1]:* are allowed for /v1/* and /health.
# Example (LAN device testing): SIGNAL_CORS_ORIGINS=http://192.168.0.12:8081
# SIGNAL_CORS_ORIGINS=

# PostgreSQL runtime/migration target. Postgres is the only supported runtime DB.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
# SIGNAL_POSTGRES_POOL_MAX=10
# SIGNAL_POSTGRES_CONNECT_TIMEOUT_MS=5000
# SIGNAL_POSTGRES_IDLE_TIMEOUT_MS=30000

# Runtime split. For an API-only Railway service set this to false, and run a separate worker service.
# SIGNAL_SCHEDULER_ENABLED=true
# Notification push sender. Keep disabled until Expo/FCM delivery is intentionally connected.
# SIGNAL_NOTIFICATION_SENDER_ENABLED=false
# SIGNAL_NOTIFICATION_PUSH_PROVIDER=mock # mock | expo
# SIGNAL_NOTIFICATION_SENDER_INTERVAL_MS=15000
# SIGNAL_NOTIFICATION_SENDER_BATCH_SIZE=20
# SIGNAL_SLOW_REQUEST_MS=1200
# SIGNAL_VERY_SLOW_REQUEST_MS=5000
# SIGNAL_HTTP_LOG_ALL=false
# SIGNAL_JOB_LOCK_TTL_MS=7200000

# Initial Admin UI user seed (used only when Postgres admin_users is empty): one-line JSON array.
ADMIN_USERS=[{"id":"dev","password":"change-me"}]
SESSION_SECRET=change-me-local-session-secret

# App users: RS256 JWT access (default 1h) + rotated refresh per device. If unset, server uses legacy opaque bearer only.
# Generate a PKCS#8 PEM (keep private; derive public in-process for verification):
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signal-jwt.pem
# SIGNAL_JWT_PRIVATE_KEY="$(perl -0777 -pe 's/\n/\\n/g' signal-jwt.pem)"
# Or base64 single line: base64 -i signal-jwt.pem | tr -d '\n'  -> SIGNAL_JWT_PRIVATE_KEY_B64
# Railway/production: set SIGNAL_JWT_PRIVATE_KEY_B64 on the HTTP API service and redeploy.
# Check runtime status with GET /v1/auth/jwt/config; it should return configured=true and valid=true.
# Temporary Railway diagnosis only: SIGNAL_JWT_DEBUG=1 logs masked metadata, never the full key.
# SIGNAL_JWT_DEBUG=1
# SIGNAL_JWT_ISSUER=signal-api
# SIGNAL_JWT_AUDIENCE=signal-app
# SIGNAL_JWT_ACCESS_TTL_SEC=3600
# SIGNAL_JWT_REFRESH_TTL_DAYS=90

# Optional seed/fallback values. Prefer Admin > Settings for local operation.
# FINNHUB_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# YOUTUBE_API_KEY=
# NINJAS_KEY=
# SEC EDGAR public APIs require an identifying User-Agent. Example: SignalApp admin@example.com
# SEC_USER_AGENT=
# OPENDART (DART) Open API key from https://opendart.fss.or.kr/
# DART_API_KEY=

# Toss Invest Open API (WTS > 설정 > Open API). Prefer Admin PATCH /admin/api/provider-settings/tossinvest.
# TOSSINVEST_CLIENT_ID=
# TOSSINVEST_CLIENT_SECRET=
# TOSSINVEST_ACCOUNT_SEQ=1
# TOSSINVEST_API_BASE_URL=https://openapi.tossinvest.com


# Optional seed/fallback values. Prefer Admin > Translation Settings for local operation.
# Translation providers: mock | openai | claude
# OpenAI suggested starter model: gpt-4o-mini
# Claude suggested starter model: claude-3-5-haiku-latest
TRANSLATION_PROVIDER=mock
TRANSLATION_MODEL=mock-ko-news-v1
