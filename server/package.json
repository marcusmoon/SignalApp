{
  "name": "signal-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "start": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "worker": "node --disable-warning=ExperimentalWarning src/worker.mjs",
    "db:postgres:check": "node scripts/checkPostgres.mjs",
    "railway:build": "cd .. && npm install && npm run web:export && npm --prefix server install",
    "railway:start": "npm run start"
  },
  "dependencies": {
    "jose": "^5.10.0",
    "kysely": "^0.29.2",
    "pg": "^8.21.0"
  }
}
